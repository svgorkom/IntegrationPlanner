<Window x:Class="IntegrationPlanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:IntegrationPlanner.UI.Localization"
        xmlns:rendering="clr-namespace:IntegrationPlanner.UI.Rendering"
        xmlns:behaviors="clr-namespace:IntegrationPlanner.UI.Behaviors"
        xmlns:vm="clr-namespace:IntegrationPlanner.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Style="{StaticResource MainWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Command="{Binding NewCommand, Mode=OneTime}" Gesture="Ctrl+N" />
        <KeyBinding Command="{Binding OpenCommand, Mode=OneTime}" Gesture="Ctrl+O" />
        <KeyBinding Command="{Binding SaveCommand, Mode=OneTime}" Gesture="Ctrl+S" />
        <KeyBinding Command="{Binding SaveAsCommand, Mode=OneTime}" Gesture="Ctrl+Shift+S" />
        <KeyBinding Command="{Binding UndoCommand, Mode=OneTime}" Gesture="Ctrl+Z" />
        <KeyBinding Command="{Binding RedoCommand, Mode=OneTime}" Gesture="Ctrl+Y" />
        <KeyBinding Command="{Binding DeleteSelectionCommand, Mode=OneTime}" Gesture="Delete" />
        <KeyBinding Command="{Binding CopyToClipboardCommand, Mode=OneTime}" Gesture="Ctrl+Shift+C" />
        <KeyBinding Command="{Binding ZoomInCommand, Mode=OneTime}" Gesture="Ctrl+OemPlus" />
        <KeyBinding Command="{Binding ZoomOutCommand, Mode=OneTime}" Gesture="Ctrl+OemMinus" />
        <KeyBinding Command="{Binding ResetZoomCommand, Mode=OneTime}" Gesture="Ctrl+D0" />
    </Window.InputBindings>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="46">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE8E5;" Command="{Binding OpenCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarOpenToolTip}" />
                <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE74E;" Command="{Binding SaveCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarSaveToolTip}" />
                <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE7A7;" Command="{Binding UndoCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarUndoToolTip}" />
                <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE7A6;" Command="{Binding RedoCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarRedoToolTip}" />
                <Button x:Name="MoreButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE712;" ToolTip="{loc:Loc ToolbarMoreToolTip}" Click="OnMoreClick">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="{loc:Loc ToolbarNew}" Command="{Binding NewCommand, Mode=OneTime}" />
                            <MenuItem Header="{loc:Loc ToolbarSaveAs}" Command="{Binding SaveAsCommand, Mode=OneTime}" />
                            <Separator />
                            <MenuItem Header="{loc:Loc ToolbarExportPng}" Command="{Binding ExportPngCommand, Mode=OneTime}" />
                            <MenuItem Header="{loc:Loc ToolbarExportSvg}" Command="{Binding ExportSvgCommand, Mode=OneTime}" />
                            <MenuItem Header="{loc:Loc ToolbarCopy}" Command="{Binding CopyToClipboardCommand, Mode=OneTime}" />
                            <Separator />
                            <MenuItem Header="{loc:Loc ToolbarAddFromJira}" Click="OnAddFromJira" IsEnabled="{Binding HasPlan, Mode=OneWay}" />
                            <MenuItem Header="{loc:Loc ToolbarJiraSettings}" Click="OnJiraSettings" />
                            <MenuItem Header="{loc:Loc ToolbarToggleTheme}" Click="OnToggleTheme" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleTextStyle}" Text="{Binding WindowTitle, Mode=OneWay}" />
            <Border Grid.Column="2" Width="140" />
        </Grid>

        <Border DockPanel.Dock="Left" Style="{StaticResource ExplorerPanelStyle}" IsEnabled="{Binding HasPlan, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc ExplorerScenarios}" />
                    <Button Style="{StaticResource PanelAddButtonStyle}" HorizontalAlignment="Right" Content="&#xE710;" Command="{Binding AddScenarioCommand, Mode=OneTime}" ToolTip="{loc:Loc ExplorerAddScenarioToolTip}" />
                </Grid>
                <ListBox Grid.Row="2"
                         Style="{StaticResource ExplorerListBoxStyle}"
                         ItemsSource="{Binding Scenarios, Mode=OneTime}"
                         SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                         AutomationProperties.Name="{loc:Loc ExplorerScenarios}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc ExplorerAdd}" Command="{Binding AddScenarioCommand, Mode=OneTime}" />
                            <MenuItem Header="{loc:Loc ExplorerDuplicateScenario}" Command="{Binding DuplicateScenarioCommand, Mode=OneTime}" />
                            <MenuItem Header="{loc:Loc ExplorerDeleteScenario}" Command="{Binding DeleteScenarioCommand, Mode=OneTime}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <Grid Grid.Row="3">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{loc:Loc ExplorerBranches}" />
                    <Button Style="{StaticResource PanelAddButtonStyle}" HorizontalAlignment="Right" Content="&#xE710;" Command="{Binding AddBranchCommand, Mode=OneTime}" ToolTip="{loc:Loc ExplorerAddBranchToolTip}" />
                </Grid>
                <ListBox Grid.Row="5"
                         Style="{StaticResource ExplorerListBoxStyle}"
                         ItemsSource="{Binding Branches, Mode=OneTime}"
                         SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                         AutomationProperties.Name="{loc:Loc ExplorerBranches}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc ExplorerAdd}" Command="{Binding AddBranchCommand, Mode=OneTime}" />
                            <MenuItem Header="{loc:Loc ToolbarDelete}" Command="{Binding DeleteSelectionCommand, Mode=OneTime}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Right" Style="{StaticResource PropertyPanelStyle}" IsEnabled="{Binding HasPlan, Mode=OneWay}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintTextStyle}" Text="{loc:Loc PropertiesDragHint}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding SelectedProperties, Mode=OneWay}" Focusable="False" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource CanvasPanelStyle}">
        <Grid x:Name="CanvasHost">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Loc ContextRename}" Click="OnRenameSelected" />
                    <MenuItem Header="{loc:Loc ToolbarAddBranch}" Command="{Binding AddBranchCommand, Mode=OneTime}" />
                    <MenuItem Header="{loc:Loc ToolbarAddMarker}" Command="{Binding AddMarkerCommand, Mode=OneTime}" />
                    <MenuItem Header="{loc:Loc ToolbarAddPull}" Command="{Binding AddPullCommand, Mode=OneTime}" />
                    <MenuItem Header="{loc:Loc ToolbarAddMerge}" Command="{Binding AddMergeCommand, Mode=OneTime}" />
                    <Separator />
                    <MenuItem Header="{loc:Loc ToolbarDelete}" Command="{Binding DeleteSelectionCommand, Mode=OneTime}" />
                </ContextMenu>
            </Grid.ContextMenu>
            <ScrollViewer x:Name="DiagramScroll" SizeChanged="OnDiagramScrollSizeChanged" Style="{StaticResource DiagramScrollViewerStyle}"
                          behaviors:ScrollViewerBehaviors.ZoomInCommand="{Binding ZoomInCommand, Mode=OneTime}"
                          behaviors:ScrollViewerBehaviors.ZoomOutCommand="{Binding ZoomOutCommand, Mode=OneTime}"
                          behaviors:ScrollViewerBehaviors.IsDragPanEnabled="True">
                <rendering:SceneCanvas x:Name="Diagram" Style="{StaticResource SceneCanvasStyle}"
                                       Scene="{Binding Scene, Mode=OneWay}"
                                       RenameRequested="OnRenameRequested"
                                       ConnectCommand="{Binding ConnectElementsCommand, Mode=OneTime}"
                                       SelectCommand="{Binding SelectElementCommand, Mode=OneTime}"
                                       MoveCommand="{Binding MoveElementCommand, Mode=OneTime}"
                                       ReshapeCommand="{Binding ReshapeMarkerCommand, Mode=OneTime}"
                                       SelectedKeys="{Binding SelectedKeys, Mode=OneWay}"
                                       DragTargets="{Binding DragTargets, Mode=OneWay}"
                                       HorizontalSnap="{Binding HorizontalSnap, Mode=OneTime}"
                                       VerticalSnap="{Binding VerticalSnap, Mode=OneTime}">
                    <rendering:SceneCanvas.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom, Mode=OneWay}" ScaleY="{Binding Zoom, Mode=OneWay}" />
                    </rendering:SceneCanvas.LayoutTransform>
                </rendering:SceneCanvas>
            </ScrollViewer>
            <TextBlock Style="{StaticResource EmptyStateTextStyle}"
                       Text="{loc:Loc EmptyStateText}"
                       Visibility="{Binding Scene, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />
            <Border Style="{StaticResource ZoomBarStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ZoomButtonStyle}" Content="{loc:Loc ToolbarZoomOut}" Command="{Binding ZoomOutCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarZoomOutToolTip}" />
                    <Button Style="{StaticResource ZoomValueButtonStyle}" Content="{Binding Zoom, Mode=OneWay}" ContentStringFormat="P0" Command="{Binding ResetZoomCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarResetZoomToolTip}" />
                    <Button Style="{StaticResource ZoomButtonStyle}" Content="{loc:Loc ToolbarZoomIn}" Command="{Binding ZoomInCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarZoomInToolTip}" />
                    <Button Style="{StaticResource ZoomValueButtonStyle}" Content="{loc:Loc ToolbarFit}" Command="{Binding FitToWindowCommand, Mode=OneTime}" ToolTip="{loc:Loc ToolbarFitToolTip}" />
                </StackPanel>
            </Border>
            <TextBox x:Name="InlineEditor" Style="{StaticResource InlineEditorTextBoxStyle}" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                     LostKeyboardFocus="OnInlineEditorLostFocus" PreviewKeyDown="OnInlineEditorKeyDown" />
        </Grid>
        </Border>
    </DockPanel>
</Window>
