<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rendering="clr-namespace:IntegrationPlanner.UI.Rendering"
                    xmlns:converters="clr-namespace:IntegrationPlanner.UI.Converters">
    <Color x:Key="PrimaryColor">#1F5670</Color>
    <Color x:Key="CancelledColor">#C00000</Color>
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="CanvasSurroundColor">#F2F4F5</Color>
    <Color x:Key="MarkerTextColor">#FFFFFF</Color>
    <FontFamily x:Key="DiagramFontFamily">Calibri</FontFamily>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="CancelledBrush" Color="{StaticResource CancelledColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="{StaticResource CanvasSurroundColor}" />
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#66F0A030" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D0D7DB" />
    <SolidColorBrush x:Key="HintBrush" Color="#5F6B72" />

    <!-- Diagram look shared by screen rendering, PNG/clipboard export and SVG export. -->
    <rendering:ScenePalette x:Key="ScenePalette"
                            LineColor="{StaticResource PrimaryColor}"
                            TextColor="{StaticResource PrimaryColor}"
                            CancelledColor="{StaticResource CancelledColor}"
                            MarkerFillColor="{StaticResource PrimaryColor}"
                            MarkerTextColor="{StaticResource MarkerTextColor}"
                            BackgroundColor="{StaticResource BackgroundColor}"
                            FontFamily="{StaticResource DiagramFontFamily}"
                            LineThickness="1.25"
                            MarkerOutlineThickness="1.5"
                            DashLength="6"
                            DashGap="4" />

    <converters:NullToVisibilityConverter x:Key="NullToVisibleConverter" NullValue="Visible" NotNullValue="Collapsed" />
    <BooleanToVisibilityConverter x:Key="TrueToVisibleConverter" />

    <Style x:Key="MainWindowStyle" TargetType="Window">
        <Setter Property="Width" Value="1280" />
        <Setter Property="Height" Value="800" />
        <Setter Property="MinWidth" Value="640" />
        <Setter Property="MinHeight" Value="400" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style x:Key="MainToolBarTrayStyle" TargetType="ToolBarTray">
        <Setter Property="IsLocked" Value="True" />
    </Style>

    <Style x:Key="MainToolBarStyle" TargetType="ToolBar">
        <Setter Property="ToolBarTray.IsLocked" Value="True" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style x:Key="ToolBarLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style x:Key="SidePanelStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="ExplorerPanelStyle" TargetType="Border" BasedOn="{StaticResource SidePanelStyle}">
        <Setter Property="Width" Value="220" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="PropertyPanelStyle" TargetType="Border" BasedOn="{StaticResource SidePanelStyle}">
        <Setter Property="Width" Value="300" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="PanelButtonRowStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PanelButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="ExplorerListBoxStyle" TargetType="ListBox">
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Each committed change is one plan-level undo step, so the text box keeps no undo history of its own. -->
    <Style x:Key="PropertyTextBoxStyle" TargetType="TextBox">
        <Setter Property="IsUndoEnabled" Value="False" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style x:Key="PropertyMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PropertyTextBoxStyle}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="PropertyComboBoxStyle" TargetType="ComboBox">
        <Setter Property="DisplayMemberPath" Value="Text" />
    </Style>

    <Style x:Key="PropertyCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="DiagramScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{StaticResource CanvasSurroundBrush}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="SceneCanvasStyle" TargetType="rendering:SceneCanvas">
        <Setter Property="Palette" Value="{StaticResource ScenePalette}" />
        <Setter Property="HighlightBrush" Value="{StaticResource SelectionHighlightBrush}" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>
</ResourceDictionary>
