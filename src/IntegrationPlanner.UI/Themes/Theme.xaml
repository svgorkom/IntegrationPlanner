<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rendering="clr-namespace:IntegrationPlanner.UI.Rendering"
                    xmlns:converters="clr-namespace:IntegrationPlanner.UI.Converters">
    <Color x:Key="PrimaryColor">#1F5670</Color>
    <Color x:Key="CancelledColor">#C00000</Color>
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="CanvasSurroundColor">#F2F4F5</Color>
    <Color x:Key="MarkerTextColor">#FFFFFF</Color>
    <FontFamily x:Key="DiagramFontFamily">Calibri</FontFamily>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="CancelledBrush" Color="{StaticResource CancelledColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="{StaticResource CanvasSurroundColor}" />

    <!-- Diagram look shared by screen rendering, PNG/clipboard export and SVG export. -->
    <rendering:ScenePalette x:Key="ScenePalette"
                            LineColor="{StaticResource PrimaryColor}"
                            TextColor="{StaticResource PrimaryColor}"
                            CancelledColor="{StaticResource CancelledColor}"
                            MarkerFillColor="{StaticResource PrimaryColor}"
                            MarkerTextColor="{StaticResource MarkerTextColor}"
                            BackgroundColor="{StaticResource BackgroundColor}"
                            FontFamily="{StaticResource DiagramFontFamily}"
                            LineThickness="1.25"
                            MarkerOutlineThickness="1.5"
                            DashLength="6"
                            DashGap="4" />

    <converters:NullToVisibilityConverter x:Key="NullToVisibleConverter" NullValue="Visible" NotNullValue="Collapsed" />

    <Style x:Key="MainWindowStyle" TargetType="Window">
        <Setter Property="Width" Value="1280" />
        <Setter Property="Height" Value="800" />
        <Setter Property="MinWidth" Value="640" />
        <Setter Property="MinHeight" Value="400" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style x:Key="MainToolBarTrayStyle" TargetType="ToolBarTray">
        <Setter Property="IsLocked" Value="True" />
    </Style>

    <Style x:Key="MainToolBarStyle" TargetType="ToolBar">
        <Setter Property="ToolBarTray.IsLocked" Value="True" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style x:Key="ToolBarLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style x:Key="ScenarioComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style x:Key="DiagramScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Background" Value="{StaticResource CanvasSurroundBrush}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="SceneCanvasStyle" TargetType="rendering:SceneCanvas">
        <Setter Property="Palette" Value="{StaticResource ScenePalette}" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</ResourceDictionary>
