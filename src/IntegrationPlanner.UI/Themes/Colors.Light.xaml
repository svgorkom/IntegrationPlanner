<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rendering="clr-namespace:IntegrationPlanner.UI.Rendering">
    <!-- Light variant. Brushes are translucent so that the Mica backdrop shows through the panels. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2B34" />
    <SolidColorBrush x:Key="HintBrush" Color="#5F6B72" />
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#33000000" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ChromePressedBrush" Color="#24000000" />
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#66F0A030" />
    <SolidColorBrush x:Key="ConnectPreviewBrush" Color="#CC0A6CBD" />

    <rendering:ScenePalette x:Key="ActiveScenePalette"
                            LineColor="#1F5670"
                            TextColor="#1F5670"
                            CancelledColor="#C00000"
                            MarkerFillColor="#1F5670"
                            MarkerTextColor="#FFFFFF"
                            BackgroundColor="#FFFFFF"
                            FontFamily="Calibri"
                            LineThickness="1.25"
                            MarkerOutlineThickness="1.5"
                            DashLength="6"
                            DashGap="4" />
</ResourceDictionary>
