<Window x:Class="IntegrationPlanner.UI.AddBranchFromTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IntegrationPlanner.UI.Localization"
        Title="{loc:Loc AddFromJiraTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}">
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource PropertyLabelStyle}" Text="{loc:Loc JiraSearchLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource PropertyTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand, Mode=OneTime}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Content="{loc:Loc JiraSearchButton}" Command="{Binding SearchCommand, Mode=OneTime}" />
        </Grid>
        <ListBox Height="180" Margin="0,10,0,0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedIssue}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run FontWeight="SemiBold" Text="{Binding Key, Mode=OneTime}" />
                        <Run Text="{Binding Summary, Mode=OneTime}" />
                        <Run Foreground="{DynamicResource HintBrush}" Text="{Binding Status, Mode=OneTime, StringFormat=({0})}" />
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Style="{StaticResource PropertyLabelStyle}" Margin="0,10,0,0" Text="{loc:Loc JiraBranchNameLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource PropertyTextBoxStyle}" Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Content="{loc:Loc JiraResetName}" Command="{Binding ResetNameCommand, Mode=OneTime}" />
        </Grid>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="32" Text="{Binding StatusMessage, Mode=OneWay}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Padding="12,4" Margin="0,0,8,0" IsDefault="True" Content="{loc:Loc JiraAddBranch}" Command="{Binding AddCommand, Mode=OneTime}" />
            <Button Padding="12,4" IsCancel="True" Content="{loc:Loc JiraCancel}" Command="{Binding CancelCommand, Mode=OneTime}" />
        </StackPanel>
    </StackPanel>
</Window>
